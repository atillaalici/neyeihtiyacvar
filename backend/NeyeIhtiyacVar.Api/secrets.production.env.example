# BU DOSYA ORNEKTIR. Gercek secret degerlerini bu dosyaya yazmayin.
# Sunucuda ayri bir secrets.production.env dosyasi olusturulacak ve Git'e alinmayacak.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5155

ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=neyeihtiyacvar;Username=neyeihtiyacvar;Password=CHANGE_ME

